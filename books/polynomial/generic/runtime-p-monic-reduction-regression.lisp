(in-package "GPOLY")

(include-book "runtime-p-monic-reduction")

(assert-event (equal (runtime-p-monic-remainder '(1 0 1) '(1 0 1) 7) nil))
(assert-event (equal (runtime-p-monic-remainder '(3 2) '(1 0 1) 7) '(3 2)))
(assert-event (equal (runtime-p-monic-remainder nil '(1 0 1) 7) nil))
(assert-event (equal (runtime-p-monic-remainder '(1 2 3) nil 7) '(1 2 3)))
(assert-event (equal (runtime-p-monic-remainder '(1 2 3) '(2 0 2) 7) '(1 2 3)))
(assert-event (equal (runtime-p-monic-remainder '(1 2 3) '(1) 7) nil))
(assert-event (equal (runtime-p-monic-remainder 'bad '(1 0 1) 7) nil))
(assert-event (equal (runtime-p-monic-remainder '(1 2 . bad) '(1 0 1) 7) '(1 2)))
(assert-event (equal (runtime-p-monic-remainder '(1 0 1 0) '(1 0 1 0) 7) nil))
(assert-event (equal (runtime-p-monic-remainder '(1 0 0 0 1) '(1 0 1) 7) '(2)))
(assert-event (equal (runtime-p-monic-remainder '(1 0 1) '(1 0 1) 'bad) nil))
(assert-event (equal (runtime-p-monic-remainder '(1 0 1) '(1 0 1) 1) nil))
(assert-event (equal (runtime-p-monic-remainder '(1 0 0 1) '(1 1) 6) nil))
(assert-event (equal (runtime-p-reduced-add '(6 1) '(2 6) '(1 0 1) 7) '(1)))
(assert-event (equal (runtime-p-reduced-mul '(0 1) '(0 1) '(1 0 1) 7) '(6)))
