(in-package "GFIELD")

(include-book "finite-field-context")
(include-book "pfield-cardinality")
(include-book "../algebra/finite-bijection")

(defthm posp-of-pfield-modulus-for-finite-bijection
  (posp (pfield-modulus))
  :hints (("Goal" :use pfield-modulus-lower-bound)))

(defthm natp-of-pfield-fix-for-finite-bijection
  (natp (pfield-fix x))
  :rule-classes (:rewrite :type-prescription)
  :hints (("Goal" :use pfield-fep-of-pfield-fix
           :in-theory (enable pfield::fep))))

(defthm pfield-fix-upper-bound-for-finite-bijection
  (< (pfield-fix x) (pfield-modulus))
  :rule-classes (:rewrite :linear)
  :hints (("Goal" :use pfield-fep-of-pfield-fix
           :in-theory (enable pfield::fep))))

(defthm pfield-fix-of-fix-for-finite-bijection
  (equal (pfield-fix (pfield-fix x)) (pfield-fix x))
  :hints (("Goal" :use pfield-fix-idempotent)))

(defthm pfield-fix-of-unrank-for-finite-bijection
  (equal (pfield-fix (pfield-fix k)) (pfield-fix k))
  :hints (("Goal" :use (:instance pfield-fix-idempotent (x k)))))

(defthm pfield-fix-inverse-when-bounded
  (implies (and (natp k) (< k (pfield-modulus)))
           (equal (pfield-fix (pfield-fix k)) k))
  :hints (("Goal"
           :use ((:instance pfield-fix-when-pfield-element-p (x k))
                 (:instance pfield-fix-idempotent (x k)))
           :in-theory (enable pfield-element-p pfield::fep))))

(defthm pfield-fix-when-natural-and-bounded
  (implies (and (natp k) (< k (pfield-modulus)))
           (equal (pfield-fix k) k))
  :hints (("Goal" :use pfield-fix-inverse-when-bounded)))

; Keep the entire joint constraint set available as one deliberately disabled
; proving seam.  Concrete instances can use this theorem at the constraint
; subgoals generated by a functional instance without enabling the field
; theory globally.
(defthm pfield-finite-field-context-constraint-seam
  (and
   (booleanp (pfield-element-p x))
   (pfield-element-p (pfield-fix x))
   (implies (pfield-element-p x) (equal (pfield-fix x) x))
   (equal (pfield-fix (pfield-fix x)) (pfield-fix x))
   (pfield-element-p (pfield-zero))
   (pfield-element-p (pfield-one))
   (not (equal (pfield-zero) (pfield-one)))
   (equal (pfield-fix (pfield-zero)) (pfield-zero))
   (equal (pfield-fix (pfield-one)) (pfield-one))
   (pfield-element-p (pfield-add x y))
   (pfield-element-p (pfield-mul x y))
   (pfield-element-p (pfield-neg x))
   (pfield-element-p (pfield-inv x))
   (equal (pfield-fix (pfield-add x y)) (pfield-add x y))
   (equal (pfield-fix (pfield-mul x y)) (pfield-mul x y))
   (equal (pfield-fix (pfield-neg x)) (pfield-neg x))
   (equal (pfield-fix (pfield-inv x)) (pfield-inv x))
   (equal (pfield-add (pfield-fix x) (pfield-fix y)) (pfield-add x y))
   (equal (pfield-add (pfield-fix x) y) (pfield-add x y))
   (equal (pfield-add x (pfield-fix y)) (pfield-add x y))
   (equal (pfield-mul (pfield-fix x) y) (pfield-mul x y))
   (equal (pfield-mul x (pfield-fix y)) (pfield-mul x y))
   (equal (pfield-mul (pfield-fix x) (pfield-fix y)) (pfield-mul x y))
   (equal (pfield-neg (pfield-fix x)) (pfield-neg x))
   (equal (pfield-inv (pfield-fix x)) (pfield-inv x))
   (equal (pfield-add (pfield-add x y) z) (pfield-add x (pfield-add y z)))
   (equal (pfield-add x y) (pfield-add y x))
   (equal (pfield-add (pfield-zero) x) (pfield-fix x))
   (equal (pfield-add (pfield-neg x) x) (pfield-zero))
   (implies (and (equal (pfield-fix x1) (pfield-fix x2))
                 (equal (pfield-fix y1) (pfield-fix y2)))
            (equal (pfield-add x1 y1) (pfield-add x2 y2)))
   (implies (and (equal (pfield-fix x1) (pfield-fix x2))
                 (equal (pfield-fix y1) (pfield-fix y2)))
            (equal (pfield-mul x1 y1) (pfield-mul x2 y2)))
   (equal (pfield-mul (pfield-mul x y) z) (pfield-mul x (pfield-mul y z)))
   (equal (pfield-mul x y) (pfield-mul y x))
   (equal (pfield-mul (pfield-one) x) (pfield-fix x))
   (equal (pfield-mul x (pfield-add y z))
          (pfield-add (pfield-mul x y) (pfield-mul x z)))
   (equal (pfield-inv (pfield-zero)) (pfield-zero))
   (implies (not (equal (pfield-fix x) (pfield-zero)))
            (equal (pfield-mul (pfield-inv x) x) (pfield-one)))
   (posp (pfield-modulus))
   (natp (pfield-fix x))
   (< (pfield-fix x) (pfield-modulus))
   (equal (pfield-fix (pfield-fix k)) (pfield-fix k))
   (equal (pfield-fix (pfield-fix x)) (pfield-fix x))
   (implies (and (natp k) (< k (pfield-modulus)))
            (equal (pfield-fix (pfield-fix k)) k)))
  :rule-classes nil
  :hints (("Goal"
           :use (booleanp-of-pfield-element-p pfield-element-p-of-pfield-fix
                 pfield-fix-when-pfield-element-p pfield-fix-idempotent
                 pfield-element-p-of-pfield-zero pfield-element-p-of-pfield-one
                 pfield-zero-not-equal-pfield-one pfield-fix-of-zero
                 pfield-fix-of-one pfield-element-p-of-pfield-add
                 pfield-element-p-of-pfield-mul pfield-element-p-of-pfield-neg
                 pfield-element-p-of-pfield-inv pfield-fix-of-pfield-add
                 pfield-fix-of-pfield-mul pfield-fix-of-pfield-neg
                 pfield-fix-of-pfield-inv pfield-add-of-fixes
                 pfield-add-fix-left pfield-add-fix-right pfield-mul-fix-left
                 pfield-mul-fix-right pfield-mul-of-fixes pfield-neg-of-fix
                 pfield-inv-of-fix pfield-add-associative
                 pfield-add-commutative pfield-add-zero-left
                 pfield-add-inverse-left pfield-add-fixed-congruence
                 pfield-mul-fixed-congruence pfield-mul-associative
                 pfield-mul-commutative pfield-mul-one-left
                 pfield-mul-left-distributive pfield-inv-of-zero
                 pfield-mul-inverse-left posp-of-pfield-modulus-for-finite-bijection
                 natp-of-pfield-fix-for-finite-bijection
                 pfield-fix-upper-bound-for-finite-bijection
                 pfield-fix-of-unrank-for-finite-bijection
                 pfield-fix-inverse-when-bounded)
           :in-theory (theory 'minimal-theory))))

