(in-package "GFIELD")

(include-book "points")
(include-book "f11-affine-coordinates")

(defun f11-curve-point-infinity () (list :infinity))
(defun f11-curve-point-affine-coordinates (coordinates)
  (list :affine (f11-affine-coordinates-fix coordinates)))
(defun f11-curve-point-affine (x y)
  (f11-curve-point-affine-coordinates
   (f11-affine-coordinates-make x y)))
(defun f11-curve-point-infinity-p (point)
  (equal point (f11-curve-point-infinity)))
(defun f11-curve-point-affine-coordinates-get (point)
  (if (and (true-listp point) (equal (len point) 2)
           (equal (car point) :affine))
      (f11-affine-coordinates-fix (cadr point))
    (f11-affine-coordinates-fix nil)))
(defun f11-curve-point-fix (point)
  (cond ((f11-curve-point-infinity-p point) (f11-curve-point-infinity))
        ((and (true-listp point) (equal (len point) 2)
              (equal (car point) :affine)
              (true-listp (cadr point)) (equal (len (cadr point)) 2))
         (f11-curve-point-affine-coordinates (cadr point)))
        (t (f11-curve-point-infinity))))
(defun f11-curve-point-representation-p (point)
  (equal (f11-curve-point-fix point) point))
(defun f11-short-weierstrass-curve-point-p (point)
  (and (f11-curve-point-representation-p point)
       (or (f11-curve-point-infinity-p point)
           (and (equal (car point) :affine)
                (f11-short-weierstrass-affine-point-p
                 (f11-curve-point-affine-coordinates-get point))))))

(assert-event (f11-curve-point-infinity-p (f11-curve-point-infinity)))
(assert-event (f11-curve-point-representation-p (f11-curve-point-infinity)))
(assert-event (equal (f11-curve-point-fix (f11-curve-point-fix '(:infinity)))
                     '(:infinity)))
(assert-event (f11-short-weierstrass-curve-point-p '(:infinity)))
(assert-event (equal (f11-curve-point-affine 2 4) '(:affine (2 4))))
(assert-event (f11-short-weierstrass-curve-point-p '(:affine (2 4))))
(assert-event (f11-curve-point-representation-p '(:affine (2 5))))
(assert-event (not (f11-short-weierstrass-curve-point-p '(:affine (2 5)))))
(assert-event (equal (f11-curve-point-fix '(:affine (13 15)))
                     '(:affine (2 4))))
(assert-event (equal (f11-curve-point-fix '(:affine bad)) '(:infinity)))
(assert-event (equal (f11-curve-point-fix '(:unknown (2 4))) '(:infinity)))
(assert-event (equal (f11-curve-point-fix 'bad) '(:infinity)))
(assert-event (equal (f11-curve-point-fix '(:affine (2 4) extra)) '(:infinity)))
(assert-event (equal (f11-curve-point-fix '(:affine . (2 4))) '(:infinity)))
(assert-event (equal (f11-curve-point-fix
                      (f11-curve-point-fix '(:affine (13 15))))
                     '(:affine (2 4))))
(assert-event (equal (f11-curve-point-affine-coordinates-get '(:infinity))
                     '(0 0)))

(verify-guards f11-curve-point-infinity)
(verify-guards f11-curve-point-affine-coordinates)
(verify-guards f11-curve-point-affine)
(verify-guards f11-curve-point-infinity-p)
(verify-guards f11-curve-point-affine-coordinates-get)
(verify-guards f11-curve-point-fix)
(verify-guards f11-curve-point-representation-p)
(verify-guards f11-short-weierstrass-curve-point-p)
