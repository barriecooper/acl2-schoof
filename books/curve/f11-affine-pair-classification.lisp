(in-package "GFIELD")

(include-book "affine-pair-classification")
(include-book "f11-affine-coordinates")

(defun f11-affine-pair-classify (first second)
  (let* ((first (f11-affine-coordinates-fix first))
         (second (f11-affine-coordinates-fix second))
         (x1 (f11-affine-coordinates-x first))
         (y1 (f11-affine-coordinates-y first))
         (x2 (f11-affine-coordinates-x second))
         (y2 (f11-affine-coordinates-y second)))
    (cond ((not (equal x1 x2)) :distinct-x)
          ((equal y2 (f11-neg y1)) :opposite-y)
          ((equal y1 y2) :same-point-non-opposite)
          (t :same-x-other))))

(assert-event (equal (f11-affine-pair-classify '(2 4) '(2 4))
                     :same-point-non-opposite))
(assert-event (equal (f11-affine-pair-classify '(2 4) '(2 7)) :opposite-y))
(assert-event (equal (f11-affine-pair-classify '(2 7) '(2 4)) :opposite-y))
(assert-event (and (f11-short-weierstrass-affine-point-p '(2 4))
                   (f11-short-weierstrass-affine-point-p '(3 5))
                   (equal (f11-affine-pair-classify '(2 4) '(3 5)) :distinct-x)
                   (equal (f11-affine-pair-classify '(3 5) '(2 4)) :distinct-x)))
(assert-event (and (not (f11-short-weierstrass-affine-point-p '(2 5)))
                   (equal (f11-affine-pair-classify '(2 4) '(2 5)) :same-x-other)
                   (equal (f11-affine-pair-classify '(2 5) '(2 4)) :same-x-other)))
(assert-event (and (not (f11-short-weierstrass-affine-point-p '(1 1)))
                   (equal (f11-affine-pair-classify '(1 1) '(1 1))
                          :same-point-non-opposite)))
(assert-event (equal (f11-affine-pair-classify '(13 15) '(13 18)) :opposite-y))
(assert-event (equal (f11-affine-pair-classify 'bad '(0 0)) :opposite-y))
(assert-event (and (not (f11-short-weierstrass-affine-point-p '(0 0)))
                   (equal (f11-affine-pair-classify '(0 0) '(0 0)) :opposite-y)))
(assert-event (affine-pair-classification-result-p
               (f11-affine-pair-classify '(2 4) '(2 5))))

(verify-guards f11-affine-pair-classify)
