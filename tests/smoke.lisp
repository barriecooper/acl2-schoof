(in-package "HS")
(include-book "../books/top")
(assert-event (equal (poly-normalize '(1 2)) '(1 2)))
(assert-event (equal (poly-normalize '(1 2 0 0)) '(1 2)))
(assert-event (equal (poly-normalize '(0 0 0)) nil))
(assert-event (equal (poly-add '(1 2) '(4 3) 5) nil))
(assert-event (equal (poly-add '(1 2) '(3 1) 5) '(4 3)))
(assert-event (equal (poly-add '(1 2 3) '(4) 5) '(0 2 3)))
(assert-event (equal (poly-add '(1 2 3) '(0 0 2) 5) '(1 2)))
(assert-event (equal (poly-add nil '(1 2) 5) '(1 2)))
(assert-event (equal (poly-mul '(1 1) '(1 1) 5) '(1 2 1)))
(assert-event (equal (poly-eval '(1 2 1) 2 5) 4))
(assert-event (equal (poly-degree '(1 2 1)) 2))
(assert-event (equal (poly-mul nil '(1 2) 5) nil))
(assert-event (equal (poly-mul '(1 2) nil 5) nil))
(assert-event (equal (poly-mul (poly-one) '(1 2 0) 5) '(1 2)))
(assert-event (equal (poly-mul '(1 2 0) (poly-one) 5) '(1 2)))
(assert-event (equal (poly-mul '(1 2) '(3 4) 5) '(3 0 3)))
(assert-event (equal (poly-mul-raw '(1 1) '(1 4 0) 5) '(1 0 4 0)))
(assert-event (equal (poly-mul '(1 1) '(1 4 0) 5) '(1 0 4)))
(assert-event
 (equal (poly-eval (poly-mul '(1 2) '(3 4) 5) 2 5)
        (pfield::mul (poly-eval '(1 2) 2 5)
                     (poly-eval '(3 4) 2 5) 5)))
(assert-event (equal (hs-to-pfield-polynomial nil) nil))
(assert-event (equal (hs-to-pfield-polynomial '(1 2 3)) '(1 2 3)))
(assert-event
 (equal (pfield::eval-pfield-polynomial
         (hs-to-pfield-polynomial '(1 2 3)) 2 5)
        (poly-eval '(1 2 3) 2 5)))
(assert-event
 (and (pfield::pfield-polynomial-root-p
       (hs-to-pfield-polynomial '(1 0 1)) 2 5)
      (not (pfield::pfield-polynomial-root-p
            (hs-to-pfield-polynomial '(1 0 1)) 1 5))))
