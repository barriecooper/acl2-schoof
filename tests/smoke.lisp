(in-package "HS")
(include-book "../books/top")
(assert-event (equal (poly-normalize '(1 2)) '(1 2)))
(assert-event (equal (poly-normalize '(1 2 0 0)) '(1 2)))
(assert-event (equal (poly-normalize '(0 0 0)) nil))
(assert-event (equal (poly-add '(1 2) '(4 3) 5) nil))
(assert-event (equal (poly-add '(1 2) '(3 1) 5) '(4 3)))
(assert-event (equal (poly-add '(1 2 3) '(4) 5) '(0 2 3)))
(assert-event (equal (poly-add '(1 2 3) '(0 0 2) 5) '(1 2)))
(assert-event (equal (poly-add nil '(1 2) 5) '(1 2)))
(assert-event (equal (poly-mul '(1 1) '(1 1) 5) '(1 2 1)))
(assert-event (equal (poly-eval '(1 2 1) 2 5) 4))
(assert-event (equal (poly-degree '(1 2 1)) 2))
