(in-package "GFIELD")
(include-book "../books/field/examples/f2")
(assert-event (equal (f2-add t t) nil))
(assert-event (equal (f2-add t nil) t))
(assert-event (equal (f2-mul t t) t))
(assert-event (equal (f2-mul t nil) nil))
(assert-event (equal (f2-neg t) t))
(assert-event (equal (f2-inv t) t))
(assert-event (equal (f2-sub t t) nil))
(assert-event (equal (f2-div t t) t))
(assert-event (equal (f2-pow t 7) t))
(assert-event (equal (f2-neg (f2-neg 'not-a-boolean)) (f2-fix 'not-a-boolean)))
